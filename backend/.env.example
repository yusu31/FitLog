# ローカルの docker 専用（docker compose up -d）。ここに Neon など本物の接続文字列を書かない。
# 本物の接続文字列は、環境変数か Parameter Store で渡し、Git に入れない（.env は .gitignore 済み）。
# アプリ・結合テストは PgBouncer（トランザクションモード。本番の Neon の -pooler と同じ制約）経由でつなぐ
DATABASE_URL=postgres://fitlog:fitlog@localhost:6434/fitlog
# マイグレーション用（プーリングなしの直接接続）。ローカルでは同じ DB。
MIGRATION_DATABASE_URL=postgres://fitlog:fitlog@localhost:5434/fitlog
# 結合テスト専用の DB。テストは毎回 users を空にするので、開発の DB（fitlog）とは分ける（Issue #88）。
# あれば npm run test:e2e がこちらを使う（vitest.config.e2e.ts）。CI は書かない（CI の DB は使い捨て）
TEST_DATABASE_URL=postgres://fitlog:fitlog@localhost:6434/fitlog_test
TEST_MIGRATION_DATABASE_URL=postgres://fitlog:fitlog@localhost:5434/fitlog_test
# 認証（better-auth）。署名の秘密の文字列（32文字以上）。ここはローカル専用のダミー。本番は Parameter Store で渡す
BETTER_AUTH_SECRET=local-dev-only-secret-change-me-32chars-min
BETTER_AUTH_URL=http://localhost:3000
# 画面の開発サーバー（next dev・3001番）から /api/* を転送して使うとき、その送信元を信頼する（better-auth の Origin 検査）。本番は同じサイトなので不要
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001
