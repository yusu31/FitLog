{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "生きているかの確認（DB には触れない）",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/db": {
      "get": {
        "operationId": "getHealthDb",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDbResponse"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "DB まで届くかの確認",
        "tags": [
          "health"
        ]
      }
    },
    "/api/groups": {
      "post": {
        "operationId": "createGroup",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "409": {
            "description": "すでにグループにいる（ALREADY_IN_GROUP）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "グループを作る（作った人が最初のメンバー）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current": {
      "get": {
        "operationId": "getCurrentGroup",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "グループに入っていない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "今のグループとメンバーを返す",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current/invitations": {
      "post": {
        "operationId": "createInvitation",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationCreatedResponse"
                }
              }
            }
          },
          "404": {
            "description": "グループに入っていない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待リンクを作る（値はこの応答の1回だけ）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current/invitations/{id}": {
      "delete": {
        "operationId": "revokeInvitation",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "自分のグループの招待ではない・存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待リンクを取り消す（2回目以降も 204）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current/members/me": {
      "delete": {
        "operationId": "leaveGroup",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "グループに入っていない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "グループを出る（グループは残る）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/invitations/{token}": {
      "get": {
        "operationId": "getInvitation",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreviewResponse"
                }
              }
            }
          },
          "404": {
            "description": "存在しない・取り消し済み（INVITATION_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "期限切れ（INVITATION_EXPIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待の中身（グループ名と今の人数）を見る。ログイン不要",
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/invitations/{token}/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "404": {
            "description": "存在しない・取り消し済み（INVITATION_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "すでにグループにいる（ALREADY_IN_GROUP）・満員（GROUP_FULL）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "期限切れ（INVITATION_EXPIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待リンクでグループに参加する",
        "tags": [
          "invitations"
        ]
      }
    }
  },
  "info": {
    "title": "FitLog API",
    "description": "少人数で使う、筋トレとランの記録アプリの API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDbResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "db": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DB_UNAVAILABLE",
            "description": "画面が分岐に使う、決まった識別子"
          },
          "message": {
            "type": "string",
            "example": "データベースに接続できません",
            "description": "画面に出せる日本語の文言（内部の事情を入れない）"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "入力エラーのとき、項目ごとの理由。それ以外は null"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "CreateGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "朝ランの会",
            "minLength": 1,
            "maxLength": 20,
            "description": "グループ名（1〜20字）"
          }
        },
        "required": [
          "name"
        ]
      },
      "GroupResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "朝ランの会"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AvatarResponse": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "example": "A"
          },
          "hair": {
            "type": "number",
            "example": 1
          },
          "hairColor": {
            "type": "string",
            "example": "brown"
          },
          "shirtColor": {
            "type": "string",
            "example": "teal"
          },
          "pantsColor": {
            "type": "string",
            "example": "navy"
          }
        },
        "required": [
          "body",
          "hair",
          "hairColor",
          "shirtColor",
          "pantsColor"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "たろう"
          },
          "avatar": {
            "description": "キャラの設定。メールアドレスは返さない",
            "allOf": [
              {
                "$ref": "#/components/schemas/AvatarResponse"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "avatar"
        ]
      },
      "GroupDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "朝ランの会"
          },
          "members": {
            "description": "参加した順",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            }
          }
        },
        "required": [
          "id",
          "name",
          "members"
        ]
      },
      "InvitationCreatedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "取り消すときに使う ID"
          },
          "token": {
            "type": "string",
            "description": "招待リンクの値。**この応答の1回だけ**返す（DB にはハッシュだけを保存する）"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "作ってから7日"
          }
        },
        "required": [
          "id",
          "token",
          "expiresAt"
        ]
      },
      "InvitationPreviewResponse": {
        "type": "object",
        "properties": {
          "groupName": {
            "type": "string",
            "example": "朝トレ部"
          },
          "memberCount": {
            "type": "number",
            "example": 3,
            "description": "今の人数"
          },
          "memberMax": {
            "type": "number",
            "example": 5,
            "description": "人数の上限"
          }
        },
        "required": [
          "groupName",
          "memberCount",
          "memberMax"
        ]
      }
    }
  }
}
