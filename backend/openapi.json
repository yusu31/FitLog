{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "生きているかの確認（DB には触れない）",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/db": {
      "get": {
        "operationId": "getHealthDb",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDbResponse"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "DB まで届くかの確認",
        "tags": [
          "health"
        ]
      }
    },
    "/api/groups": {
      "post": {
        "operationId": "createGroup",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "409": {
            "description": "すでにグループにいる（ALREADY_IN_GROUP）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "グループを作る（作った人が最初のメンバー）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current": {
      "get": {
        "operationId": "getCurrentGroup",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "グループに入っていない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "今のグループとメンバーを返す",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current/invitations": {
      "post": {
        "operationId": "createInvitation",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationCreatedResponse"
                }
              }
            }
          },
          "404": {
            "description": "グループに入っていない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待リンクを作る（値はこの応答の1回だけ）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current/invitations/{id}": {
      "delete": {
        "operationId": "revokeInvitation",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "自分のグループの招待ではない・存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待リンクを取り消す（2回目以降も 204）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/groups/current/members/me": {
      "delete": {
        "operationId": "leaveGroup",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "グループに入っていない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "グループを出る（グループは残る）",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/invitations/{token}": {
      "get": {
        "operationId": "getInvitation",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreviewResponse"
                }
              }
            }
          },
          "404": {
            "description": "存在しない・取り消し済み（INVITATION_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "期限切れ（INVITATION_EXPIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待の中身（グループ名と今の人数）を見る。ログイン不要",
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/invitations/{token}/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "404": {
            "description": "存在しない・取り消し済み（INVITATION_NOT_FOUND）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "すでにグループにいる（ALREADY_IN_GROUP）・満員（GROUP_FULL）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "期限切れ（INVITATION_EXPIRED）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "招待リンクでグループに参加する",
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/exercises": {
      "get": {
        "operationId": "listExercises",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExerciseResponse"
                  }
                }
              }
            }
          }
        },
        "summary": "一覧の種目と、自分が追加した種目を返す（部位の順）",
        "tags": [
          "exercises"
        ]
      },
      "post": {
        "operationId": "createExercise",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExerciseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseResponse"
                }
              }
            }
          },
          "400": {
            "description": "名前が1〜30字でない・部位が一覧に無い（VALIDATION_ERROR）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "同じ名前（大文字小文字は区別しない）がすでにある。一覧の種目と同じ名前も同じ（EXERCISE_ALREADY_EXISTS）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "自分用の種目を追加する",
        "tags": [
          "exercises"
        ]
      }
    },
    "/api/records": {
      "post": {
        "operationId": "createRecord",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "すでにある（同じ id の再送、または同じ日の休み）。1回目の内容を返す",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordResponse"
                }
              }
            }
          },
          "201": {
            "description": "新しく作った",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordResponse"
                }
              }
            }
          },
          "400": {
            "description": "id が UUID でない・kind が workout/rest でない・recordedAt が日時でない／未来すぎる（VALIDATION_ERROR）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "同じ id が他の人の記録にある（RECORD_NOT_FOUND。存在を教えない）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "記録（筋トレ・休み）を作る。冪等",
        "tags": [
          "records"
        ]
      }
    }
  },
  "info": {
    "title": "FitLog API",
    "description": "少人数で使う、筋トレとランの記録アプリの API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDbResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "db": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DB_UNAVAILABLE",
            "description": "画面が分岐に使う、決まった識別子"
          },
          "message": {
            "type": "string",
            "example": "データベースに接続できません",
            "description": "画面に出せる日本語の文言（内部の事情を入れない）"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "入力エラーのとき、項目ごとの理由。それ以外は null"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "CreateGroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "朝ランの会",
            "minLength": 1,
            "maxLength": 20,
            "description": "グループ名（1〜20字）"
          }
        },
        "required": [
          "name"
        ]
      },
      "GroupResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "朝ランの会"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AvatarResponse": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "example": "A"
          },
          "hair": {
            "type": "number",
            "example": 1
          },
          "hairColor": {
            "type": "string",
            "example": "brown"
          },
          "shirtColor": {
            "type": "string",
            "example": "teal"
          },
          "pantsColor": {
            "type": "string",
            "example": "navy"
          }
        },
        "required": [
          "body",
          "hair",
          "hairColor",
          "shirtColor",
          "pantsColor"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "たろう"
          },
          "avatar": {
            "description": "キャラの設定。メールアドレスは返さない",
            "allOf": [
              {
                "$ref": "#/components/schemas/AvatarResponse"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "avatar"
        ]
      },
      "GroupDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "朝ランの会"
          },
          "members": {
            "description": "参加した順",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            }
          }
        },
        "required": [
          "id",
          "name",
          "members"
        ]
      },
      "InvitationCreatedResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "取り消すときに使う ID"
          },
          "token": {
            "type": "string",
            "description": "招待リンクの値。**この応答の1回だけ**返す（DB にはハッシュだけを保存する）"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "作ってから7日"
          }
        },
        "required": [
          "id",
          "token",
          "expiresAt"
        ]
      },
      "InvitationPreviewResponse": {
        "type": "object",
        "properties": {
          "groupName": {
            "type": "string",
            "example": "朝トレ部"
          },
          "memberCount": {
            "type": "number",
            "example": 3,
            "description": "今の人数"
          },
          "memberMax": {
            "type": "number",
            "example": 5,
            "description": "人数の上限"
          }
        },
        "required": [
          "groupName",
          "memberCount",
          "memberMax"
        ]
      },
      "BodyPart": {
        "type": "string",
        "enum": [
          "chest",
          "back",
          "shoulders",
          "arms",
          "abs",
          "glutes",
          "legs"
        ]
      },
      "ExerciseResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "ベンチプレス"
          },
          "bodyPart": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BodyPart"
              }
            ]
          },
          "isCustom": {
            "type": "boolean",
            "description": "自分で追加した種目なら true。一覧の種目は false"
          },
          "trialWeightKg": {
            "type": "number",
            "nullable": true,
            "example": 20,
            "description": "お試しの前回値の重量（kg）。一覧の種目だけ。自分で追加した種目は null"
          },
          "trialReps": {
            "type": "number",
            "nullable": true,
            "example": 10,
            "description": "お試しの前回値の回数。一覧の種目だけ。自分で追加した種目は null"
          }
        },
        "required": [
          "id",
          "name",
          "bodyPart",
          "isCustom",
          "trialWeightKg",
          "trialReps"
        ]
      },
      "CreateExerciseRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ヨガ",
            "minLength": 1,
            "maxLength": 30,
            "description": "種目名（1〜30字。前後の空白は取り除く）"
          },
          "bodyPart": {
            "example": "abs",
            "description": "ヒートマップの部位。種目ごとに1つ",
            "allOf": [
              {
                "$ref": "#/components/schemas/BodyPart"
              }
            ]
          }
        },
        "required": [
          "name",
          "bodyPart"
        ]
      },
      "CreateRecordRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "端末で作る ID。同じ ID を送り直しても、記録は1件のまま（冪等）"
          },
          "kind": {
            "type": "string",
            "enum": [
              "workout",
              "rest"
            ],
            "description": "筋トレ（workout）か休み（rest）。ラン（run）は後の PR で足す"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-01T09:00:00+09:00",
            "description": "運動した時刻（ISO 8601）。未来は5分先まで"
          }
        },
        "required": [
          "id",
          "kind",
          "recordedAt"
        ]
      },
      "RecordResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "workout",
              "run",
              "rest"
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "description": "運動した時刻（UTC）"
          },
          "localDate": {
            "type": "string",
            "example": "2026-11-01",
            "description": "日本時間の日付（YYYY-MM-DD）。サーバーが recordedAt から出す"
          }
        },
        "required": [
          "id",
          "kind",
          "recordedAt",
          "localDate"
        ]
      }
    }
  }
}
