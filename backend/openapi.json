{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "生きているかの確認（DB には触れない）",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/db": {
      "get": {
        "operationId": "getHealthDb",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDbResponse"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "DB まで届くかの確認",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "FitLog API",
    "description": "少人数で使う、筋トレとランの記録アプリの API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDbResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "db": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status",
          "db"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "DB_UNAVAILABLE",
            "description": "画面が分岐に使う、決まった識別子"
          },
          "message": {
            "type": "string",
            "example": "データベースに接続できません",
            "description": "画面に出せる日本語の文言（内部の事情を入れない）"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "入力エラーのとき、項目ごとの理由。それ以外は null"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      }
    }
  }
}
